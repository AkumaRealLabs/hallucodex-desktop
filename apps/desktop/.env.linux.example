# Copy to .env.linux (Git ignored), or set DSH_DESKTOP_PACKAGE_SETTINGS=environment and pass these
# fields through the environment, as the release workflow does.
DSH_DESKTOP_APP_ID=com.hallucodex.desktop
# Public metadata embedded in the deb package, as Name <email> and an HTTPS project page.
DSH_DESKTOP_LINUX_MAINTAINER=
DSH_DESKTOP_LINUX_HOMEPAGE=
# Optional HTTPS npm registry origin for bundled runtime dependencies.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org
# Packages read updates from this repository's GitHub Releases; no update setting is needed.
