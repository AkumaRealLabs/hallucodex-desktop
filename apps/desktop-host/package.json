{
  "name": "@deepseek-ai/dsh-desktop-host",
  "description": "Private Node-mode host process for the Electron desktop application",
  "version": "0.2.1-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/cli.js",
    "lib/hallucodex.js",
    "lib/hallucodex.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "koffi": "^3.1.0",
    "@deepseek-ai/libreoffice-kit": "^0.1.5",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-schedule": "workspace:*",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/dsh-skill-office": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-pi-ai": "workspace:*",
    "@deepseek-ai/dsh-agent-default-model": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-skill": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./hallucodex": {
      "types": "./lib/types/hallucodex.d.ts",
      "default": "./lib/hallucodex.js"
    }
  }
}
